     return hr;
 }
+
+/* PlayStation 5 port: compile a graphics pipeline state's Vulkan pipeline for
+ * one draw configuration now, on the calling thread, instead of at its first
+ * draw (vkd3d compiles them lazily, on the thread that records the draw). The
+ * key is the one a draw makes: the topology set with IASetPrimitiveTopology,
+ * the stride of vertex buffer slot 0 and the bound DSV's format. */
+HRESULT vkd3d_ps5_precompile_graphics_pipeline(ID3D12PipelineState *iface, D3D12_PRIMITIVE_TOPOLOGY topology,
+        UINT stride, DXGI_FORMAT dsv_format)
+{
+    struct d3d12_pipeline_state *state = unsafe_impl_from_ID3D12PipelineState(iface);
+    uint32_t strides[D3D12_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT] = {0};
+    const struct vkd3d_format *format;
+    VkFormat vk_dsv_format = VK_FORMAT_UNDEFINED;
+    VkRenderPass vk_render_pass;
+
+    if (!state || !d3d12_pipeline_state_is_graphics(state))
+        return E_INVALIDARG;
+    strides[0] = stride;
+    if (dsv_format != DXGI_FORMAT_UNKNOWN && (format = vkd3d_get_format(state->device, dsv_format, true)))
+        vk_dsv_format = format->vk_format;
+    return d3d12_pipeline_state_get_or_create_pipeline(state, topology, strides, vk_dsv_format, &vk_render_pass)
+            ? S_OK : E_FAIL;
+}
