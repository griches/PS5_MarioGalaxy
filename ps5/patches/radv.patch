+   const char *env = getenv("ED_PS5_HDR_FORMAT");
+   return env != NULL && env[0] != '\0' ? strtoull(env, NULL, 16) : PS5_VIDEO_OUT_PIXEL_FORMAT_A2B10G10R10_HDR10;
