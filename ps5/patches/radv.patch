+ * notes (sainsaji/EVO-PLAYER-PS5 issue 41): a TV's HDR indicator came on.
+ * ED_PS5_HDR_FORMAT=<hex> tries another (testing). */
+#define PS5_VIDEO_OUT_PIXEL_FORMAT_A2B10G10R10_HDR10 UINT64_C(0x8100070422000000)
