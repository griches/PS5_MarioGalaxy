+void TextureCache::pack_begin_frame(unsigned frame_slot, unsigned frames_in_flight) {
+    if (pack_staging_.size() != frames_in_flight) {
+        pack_staging_.resize(frames_in_flight);
+    }
+    // This slot's fence has been waited on: its uploads are done.
+    pack_staging_[frame_slot].clear();
+    ++pack_frame_;
+    if (!pack_waiting_.empty() && pack::take_new_ready()) {
+        for (auto waiting = pack_waiting_.begin(); waiting != pack_waiting_.end();) {
+            if (!pack::settled(waiting->first)) {
+                ++waiting;
+                continue;
+            }
+            for (const Key& key : waiting->second) {
+                const auto it = entries_.find(key);
+                if (it == entries_.end() || it->second.allocation_bytes == 0u) {
+                    continue;
+                }
+                decoded_lru_release(key, it->second);
+                retire(std::move(it->second));
+                entries_.erase(it);
+            }
+            waiting = pack_waiting_.erase(waiting);
+        }
+    }
+    if (pack_frame_ % 600u == 0u && pack_hashed_ != pack_reported_) {
+        pack_reported_ = pack_hashed_;
+        std::fprintf(stderr,
+                     "[texpack] looked up %llu, in the pack %llu, uploaded %llu, on the GPU %zu (%.1f MiB), "
+                     "dropped %llu, waiting %zu\n",
+                     static_cast<unsigned long long>(pack_hashed_), static_cast<unsigned long long>(pack_matched_),
+                     static_cast<unsigned long long>(pack_uploads_), pack_textures_.size(),
+                     static_cast<double>(pack_bytes_) / 1048576.0, static_cast<unsigned long long>(pack_evictions_),
+                     pack_waiting_.size());
+    }
+}
