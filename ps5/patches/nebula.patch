+            const std::size_t copy_bytes =
+                std::min<std::size_t>(static_cast<std::size_t>(row_bytes[level]), loaded->level_row_bytes[level]);
+            for (std::uint32_t row = 0; row < copy_rows; ++row) {
+                std::memcpy(dst + layouts[level].Offset + static_cast<std::size_t>(row) * layouts[level].Footprint.RowPitch,
+                            loaded->data.data() + loaded->level_offsets[level] +
+                                static_cast<std::size_t>(row) * loaded->level_row_bytes[level],
