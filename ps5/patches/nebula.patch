+bool TextureCache::pack_get(const Key& key, const TexImage& image, const std::byte* guest_bytes,
+                            std::uint32_t total_guest_size, TextureHandle& handle) {
+    const std::uint32_t base_bytes = texture_guest_byte_size(image.format, image.width, image.height, 1u);
+    const std::uint64_t hash = pack::xxh64(guest_bytes, base_bytes);
