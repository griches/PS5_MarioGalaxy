+// Over budget: the least recently used GPU copies go, with the decoded
+// entries that show them (retired through their frame slot).
+void TextureCache::pack_evict_to_budget(std::uint32_t keep) {
+    while (pack_bytes_ > pack_budget_bytes() && pack_textures_.size() > 1u) {
+        auto victim = pack_textures_.end();
+        for (auto it = pack_textures_.begin(); it != pack_textures_.end(); ++it) {
+            if (it->first != keep && (victim == pack_textures_.end() || it->second.last_used < victim->second.last_used)) {
+                victim = it;
+            }
+        }
+        if (victim == pack_textures_.end()) {
+            return;
+        }
+        ID3D12Resource* const resource = victim->second.texture.Get();
+        for (auto it = entries_.begin(); it != entries_.end();) {
+            if (it->second.texture.Get() == resource) {
+                decoded_lru_release(it->first, it->second);
+                retire(std::move(it->second));
+                it = entries_.erase(it);
+            } else {
+                ++it;
+            }
+        }
+        pack_bytes_ -= std::min(pack_bytes_, victim->second.bytes);
+        ++pack_evictions_;
+        pack_textures_.erase(victim);
+    }
+}
