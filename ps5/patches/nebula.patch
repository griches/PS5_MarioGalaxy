+                     static_cast<unsigned long long>(hash), static_cast<unsigned>(image.format),
+                     id ? "in the pack" : "-");
+    }
+    if (!id) {
+        return false;
+    }
+    ++pack_matched_;
+    auto found = pack_textures_.find(*id);
+    if (found == pack_textures_.end()) {
+        if (upload_list_ == nullptr || pack_staging_.empty()) {
